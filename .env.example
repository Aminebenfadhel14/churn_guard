# ============================================================
# ChurnGuard - Exemple de configuration
# Copier ce fichier en ".env" (ignore par Git) et adapter les valeurs.
# Toutes les variables sont prefixees par CHURNGUARD_.
# ============================================================

# Cle API attendue pour les endpoints proteges (a changer !)
CHURNGUARD_API_KEY=change-me-please

# Compte admin cree automatiquement au premier demarrage (organisation
# "Default") si la base est vide. Cle de signature des sessions (JWT).
# A changer avant tout usage au-dela du local !
CHURNGUARD_ADMIN_USERNAME=admin
CHURNGUARD_ADMIN_PASSWORD=change-me-please
CHURNGUARD_JWT_SECRET_KEY=change-me-please

# Code de verification (OTP) envoye par email a la connexion. Ne s'applique
# qu'aux comptes ayant un email renseigne (sinon connexion a une seule etape).
CHURNGUARD_OTP_LENGTH=6
CHURNGUARD_OTP_EXPIRE_MINUTES=10
CHURNGUARD_OTP_MAX_ATTEMPTS=5
CHURNGUARD_OTP_RESEND_COOLDOWN_SECONDS=60
CHURNGUARD_OTP_CHALLENGE_EXPIRE_MINUTES=10

# Service d'envoi d'emails : le backend est en Python, l'envoi (nodemailer)
# est delegue a une route interne du frontend Next.js. CHURNGUARD_EMAIL_SERVICE_SECRET
# doit correspondre a INTERNAL_EMAIL_SECRET dans frontend/.env.local.
CHURNGUARD_EMAIL_SERVICE_URL=http://127.0.0.1:3000/api/internal/send-email
CHURNGUARD_EMAIL_SERVICE_SECRET=change-me-please

# Base de donnees des comptes utilisateur (multi-organisation). SQLite en
# local par defaut (aucune valeur requise) ; en production, pointer vers
# Postgres, ex: postgresql+psycopg://user:pwd@host:5432/churnguard
# CHURNGUARD_DATABASE_URL=postgresql+psycopg://user:pwd@host:5432/churnguard

# Mode debug (true/false)
CHURNGUARD_DEBUG=false

# MLflow - suivi des experiences
CHURNGUARD_MLFLOW_TRACKING_URI=file:./mlruns
CHURNGUARD_MLFLOW_EXPERIMENT_NAME=churnguard

# URL de l'API interne, utilisee par la couche MCP
CHURNGUARD_API_BASE_URL=http://127.0.0.1:8000

# LLM du Retention Copilot / expert de recommandations (API compatible OpenAI :
# Groq, OpenAI, Ollama, Gemini). Vide -> fonctionnement en mode degrade
# (recommandations generiques, synthese deterministe, sans appel LLM).
CHURNGUARD_LLM_API_KEY=
CHURNGUARD_LLM_MODEL=llama-3.3-70b-versatile
CHURNGUARD_LLM_BASE_URL=https://api.groq.com/openai/v1

# Duree (secondes) de mise en cache des recommandations IA experte par client
# (evite de rappeler le LLM pour un client deja traite recemment). 0 desactive.
CHURNGUARD_RECOMMENDATION_CACHE_TTL_SECONDS=1800
