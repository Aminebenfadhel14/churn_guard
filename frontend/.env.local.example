# ============================================================
# ChurnGuard Frontend — Exemple de configuration
# Copier ce fichier en ".env.local" (ignoré par Git).
# ============================================================

# URL du backend FastAPI ChurnGuard
CHURNGUARD_API_URL=http://127.0.0.1:8000

# Clé API attendue par le backend (en-tête x-api-key).
# Doit correspondre à CHURNGUARD_API_KEY côté backend.
CHURNGUARD_API_KEY=change-me-please

# Source des données : "true" = données mock (défaut), "false" = vrai backend.
NEXT_PUBLIC_USE_MOCK=true

# URL publique de l'app (utilisée dans les liens des emails envoyés).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Secret partagé avec le backend pour appeler cette route en interne
# (en-tête X-Internal-Secret). Doit correspondre à
# CHURNGUARD_EMAIL_SERVICE_SECRET côté backend.
INTERNAL_EMAIL_SECRET=change-me-please

# SMTP pour l'envoi des emails (bienvenue, code de vérification) via
# nodemailer. Si SMTP_HOST est vide, les emails sont journalisés dans la
# console du serveur Next.js au lieu d'être réellement envoyés (pratique en
# dev sans compte SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ChurnGuard <no-reply@churnguard.app>"
